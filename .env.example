# Which LLM provider to use: gemini | openai | groq | anthropic
LLM_PROVIDER=gemini

# Provider keys — fill only the ones you use
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Tools
TAVILY_API_KEY=

# Optional tracing
LANGSMITH_API_KEY=

# SEC EDGAR asks every client to identify itself: "AppName your-email@example.com" (no key needed)
SEC_USER_AGENT=

# --- Phase 6: app database ---
# Empty = local SQLite (data/app.db). Deployed: the Supabase 'Session pooler' URI (contains the DB password!)
DATABASE_URL=
# local = Chroma + config/documents.json (laptop); postgres = pgvector + documents table in DATABASE_URL
FILINGS_STORE=local
# Comma-separated emails that get the admin page and no daily question limit
ADMIN_EMAILS=
DAILY_QUESTION_QUOTA=10

# --- Phase 6.6: Google login (Google Cloud > Google Auth Platform > Clients) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# random, e.g. python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_SECRET=
# random; the frontend and backend share it
INTERNAL_API_TOKEN=
PUBLIC_APP_URL=http://localhost:8501
# comma-separated; empty = any verified Google account
ALLOWED_EMAILS=
